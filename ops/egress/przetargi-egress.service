[Unit]
Description=Restricted Tailscale-only proxy for przetargimiejskie
Documentation=https://github.com/110kc3/przetargimiejskie/blob/main/PL-EGRESS-PLAN.md
Requires=tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=simple
User=proxy
Group=proxy
RuntimeDirectory=squid
RuntimeDirectoryMode=0750
ExecStart=/usr/sbin/squid -N -YC -f /etc/squid/przetargi-egress.conf
ExecReload=/usr/sbin/squid -k reconfigure -f /etc/squid/przetargi-egress.conf
ExecStop=/usr/sbin/squid -k shutdown -f /etc/squid/przetargi-egress.conf
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/squid /var/log/squid /var/spool/squid

[Install]
WantedBy=multi-user.target

# Apache config for przetargimiejskie.pl on OVH shared hosting.
#
# The site is fully static (HTML + JSON in /data + extension.zip). This file is
# copied into the deploy by build-site.sh and uploaded by the OVH workflow.
# Everything is wrapped in <IfModule> so that, if a module isn't loaded, Apache
# ignores the block instead of returning 500 for the whole site.

# Serve index.html for directory requests (/archiwum/, /privacy/, /).
DirectoryIndex index.html

# Branded 404 (site/404.html) instead of Apache's default error page.
ErrorDocument 404 /404.html

# Treat text responses as UTF-8 (Polish diacritics in the HTML and JSON).
AddDefaultCharset utf-8
<IfModule mod_mime.c>
  AddType application/json .json
  AddCharset utf-8 .json .html .css .js .svg
</IfModule>

# Canonical host + scheme. OVH's Multi-site tab roots BOTH przetargimiejskie.pl
# and www.przetargimiejskie.pl at this same folder, so without the www rule below
# the entire site answers 200 on two hostnames — a duplicate-content split that
# the <link rel="canonical"> tags mitigate but do not fix.
#
# OVH terminates TLS at its load balancer and forwards the original scheme in
# X-Forwarded-Proto, so we test THAT (not %{HTTPS}, which can read "off" even on
# an HTTPS hit behind the LB and cause a redirect loop).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → apex, jumping straight to the final https:// URL. Doing it in one hop
  # matters: a http://www hit would otherwise take two redirects (www→apex, then
  # http→https), and redirect chains dilute the signal that reaches the target.
  # %1 is the captured non-www host from the RewriteCond.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Redirect ONLY when the forwarded scheme is explicitly "http". If the header
  # is ever absent, we do nothing (site stays reachable) rather than risk a loop.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Caching. This used to be "no-cache, must-revalidate" on HTML and JSON, to be
# sure visitors never saw a stale auction. That guarantee was far stronger than
# the data needs — the pipeline refreshes once a day at 04:00 UTC — and it cost a
# blocking network round-trip on *every* page view, which is a real Core Web
# Vitals penalty and therefore a ranking one.
#
# 5 minutes of staleness against a once-a-day pipeline is invisible to a visitor.
# stale-while-revalidate then lets the browser paint the cached copy instantly and
# refresh it in the background, so even the 5-minute boundary isn't a blocking
# fetch. Auction dates are days or weeks out; nothing here is second-sensitive.
<IfModule mod_headers.c>
  <FilesMatch "\.(json|html)$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=3600"
  </FilesMatch>
  # Icons and the og:image are content-stable — they change only when the brand
  # does, and a stale favicon costs nothing. Cache them for a week.
  <FilesMatch "\.(ico|png|jpg|jpeg|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.zip$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Compress text responses (HTML/JSON/CSS/JS/SVG) — big win for the data files.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Don't expose directory listings if an index is ever missing.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
